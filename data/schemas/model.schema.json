{
  "$id": "https://itrejomx.github.io/gentle-model-setup/schemas/model.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Model",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "subscription",
    "displayName",
    "lab",
    "strengths",
    "privacy",
    "effortVariants",
    "status",
    "plans"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9.\\-]*$"
    },
    "subscription": {
      "type": "string",
      "minLength": 1
    },
    "displayName": {
      "type": "string",
      "minLength": 1
    },
    "lab": {
      "enum": [
        "moonshot",
        "zhipu",
        "xai",
        "openai",
        "deepseek",
        "alibaba",
        "minimax",
        "xiaomi",
        "tencent",
        "meituan",
        "meta"
      ]
    },
    "status": {
      "enum": [
        "current",
        "legacy",
        "experimental"
      ]
    },
    "strengths": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "oneShotReasoning",
        "sustainedReasoning",
        "codingTools",
        "longContext",
        "multimodal",
        "cheap"
      ],
      "properties": {
        "oneShotReasoning": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "sustainedReasoning": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "codingTools": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "longContext": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "multimodal": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "cheap": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "oneShotReasoning": {
          "type": "string",
          "minLength": 1
        },
        "sustainedReasoning": {
          "type": "string",
          "minLength": 1
        },
        "codingTools": {
          "type": "string",
          "minLength": 1
        },
        "longContext": {
          "type": "string",
          "minLength": 1
        },
        "multimodal": {
          "type": "string",
          "minLength": 1
        },
        "cheap": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trainsOnData",
        "logRetentionDays"
      ],
      "properties": {
        "trainsOnData": {
          "type": "boolean"
        },
        "logRetentionDays": {
          "type": [
            "number",
            "null"
          ]
        }
      }
    },
    "effortVariants": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "low",
          "medium",
          "high"
        ]
      }
    },
    "plans": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "requestsPer5h",
          "requestsPerWeek",
          "requestsPerMonth",
          "monthlyUsdBucket",
          "source",
          "verifiedAt"
        ],
        "properties": {
          "requestsPer5h": {
            "type": [
              "number",
              "null"
            ]
          },
          "requestsPerWeek": {
            "type": [
              "number",
              "null"
            ]
          },
          "requestsPerMonth": {
            "type": [
              "number",
              "null"
            ]
          },
          "monthlyUsdBucket": {
            "type": "integer"
          },
          "source": {
            "type": "string",
            "format": "uri"
          },
          "verifiedAt": {
            "type": "string",
            "format": "date"
          },
          "multiplier": {
            "type": "number"
          },
          "multiplierExpiresAt": {
            "type": "string",
            "format": "date"
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "strengths"
        ],
        "properties": {
          "strengths": {
            "required": [
              "oneShotReasoning"
            ],
            "properties": {
              "oneShotReasoning": {
                "const": 3
              }
            },
            "type": "object"
          }
        }
      },
      "then": {
        "required": [
          "evidence"
        ],
        "properties": {
          "evidence": {
            "required": [
              "oneShotReasoning"
            ],
            "type": "object",
            "properties": {
              "oneShotReasoning": true
            }
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "strengths"
        ],
        "properties": {
          "strengths": {
            "required": [
              "sustainedReasoning"
            ],
            "properties": {
              "sustainedReasoning": {
                "const": 3
              }
            },
            "type": "object"
          }
        }
      },
      "then": {
        "required": [
          "evidence"
        ],
        "properties": {
          "evidence": {
            "required": [
              "sustainedReasoning"
            ],
            "type": "object",
            "properties": {
              "sustainedReasoning": true
            }
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "strengths"
        ],
        "properties": {
          "strengths": {
            "required": [
              "codingTools"
            ],
            "properties": {
              "codingTools": {
                "const": 3
              }
            },
            "type": "object"
          }
        }
      },
      "then": {
        "required": [
          "evidence"
        ],
        "properties": {
          "evidence": {
            "required": [
              "codingTools"
            ],
            "type": "object",
            "properties": {
              "codingTools": true
            }
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "strengths"
        ],
        "properties": {
          "strengths": {
            "required": [
              "longContext"
            ],
            "properties": {
              "longContext": {
                "const": 3
              }
            },
            "type": "object"
          }
        }
      },
      "then": {
        "required": [
          "evidence"
        ],
        "properties": {
          "evidence": {
            "required": [
              "longContext"
            ],
            "type": "object",
            "properties": {
              "longContext": true
            }
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "strengths"
        ],
        "properties": {
          "strengths": {
            "required": [
              "multimodal"
            ],
            "properties": {
              "multimodal": {
                "const": 3
              }
            },
            "type": "object"
          }
        }
      },
      "then": {
        "required": [
          "evidence"
        ],
        "properties": {
          "evidence": {
            "required": [
              "multimodal"
            ],
            "type": "object",
            "properties": {
              "multimodal": true
            }
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "strengths"
        ],
        "properties": {
          "strengths": {
            "required": [
              "cheap"
            ],
            "properties": {
              "cheap": {
                "const": 3
              }
            },
            "type": "object"
          }
        }
      },
      "then": {
        "required": [
          "evidence"
        ],
        "properties": {
          "evidence": {
            "required": [
              "cheap"
            ],
            "type": "object",
            "properties": {
              "cheap": true
            }
          }
        }
      }
    }
  ]
}
