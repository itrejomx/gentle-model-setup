{
  "$id": "https://itrejomx.github.io/gentle-model-setup/schemas/subscription.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Subscription",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "displayName",
    "providerPrefix",
    "billingModel",
    "budgetClass",
    "catalogSourceUrl",
    "verifiedAt"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9.\\-]*$"
    },
    "displayName": {
      "type": "string",
      "minLength": 1
    },
    "providerPrefix": {
      "type": "string",
      "minLength": 1
    },
    "billingModel": {
      "enum": ["capped", "metered"]
    },
    "budgetClass": {
      "type": "object",
      "additionalProperties": false,
      "required": ["derivedFrom", "thresholds"],
      "properties": {
        "derivedFrom": {
          "enum": ["requestsPer5h", "pricePerMTok"]
        },
        "thresholds": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["class", "max"],
            "properties": {
              "class": {
                "enum": ["sniper", "semi", "workhorse", "volume"]
              },
              "max": {
                "type": ["integer", "null"]
              }
            }
          }
        }
      }
    },
    "plans": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "displayName"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "displayName": {
            "type": "string",
            "minLength": 1
          },
          "priceUsdPerMonth": {
            "type": "number"
          }
        }
      }
    },
    "catalogSourceUrl": {
      "type": "string",
      "format": "uri"
    },
    "verifiedAt": {
      "type": "string",
      "format": "date"
    }
  },
  "if": {
    "properties": {
      "billingModel": { "const": "capped" }
    }
  },
  "then": {
    "required": ["plans"],
    "properties": {
      "plans": true
    }
  }
}
